# Database
DATABASE_URL="postgresql://user:password@localhost:5432/alfa_dashboard?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-in-production"

# OAuth Providers (optional - enable one or more)
GITHUB_ID=""
GITHUB_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email Provider (optional)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Tavily (web search)
TAVILY_API_KEY=""

# S3/R2 Storage (for file uploads)
S3_ENDPOINT=""              # e.g., https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"             # or specific region like us-east-1
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="alfa-dashboard"
S3_PUBLIC_URL=""             # e.g., https://pub-xxx.r2.dev (for public access)

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"